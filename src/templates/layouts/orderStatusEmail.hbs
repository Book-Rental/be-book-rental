<!-- Action Buttons -->
<table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td align="center" style="padding-top:25px;">

            <!-- Track Shipment -->
            {{#if trackingUrl}}
            <table cellpadding="0" cellspacing="0" border="0" style="display:inline-table;">
                <tr>
                    <td align="center" bgcolor="#146adb" style="border-radius:6px;">
                        <a href="{{trackingUrl}}" target="_blank" style="
                            display:inline-block;
                            padding:13px 25px;
                            font-size:15px;
                            font-weight:bold;
                            color:#ffffff;
                            text-decoration:none;
                            border-radius:6px;
                        ">
                            Track Your Shipment
                        </a>
                    </td>
                </tr>
            </table>
            {{/if}}

            <!-- View Order Details -->
            <table cellpadding="0" cellspacing="0" border="0" style="display:inline-table;">
                <tr>
                    <td align="center" style="
                        background-color:#ffffff;
                        border:1px solid #146adb;
                        border-radius:6px;
                    ">
                        <a href="{{orderDetailsUrl}}" target="_blank" style="
                            display:inline-block;
                            padding:12px 24px;
                            font-size:15px;
                            font-weight:bold;
                            color:#146adb;
                            text-decoration:none;
                            border-radius:6px;
                        ">
                            View Order Details
                        </a>
                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>