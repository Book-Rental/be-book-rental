<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{{statusTitle}}</title>
</head>

<body style="
    margin:0;
    padding:0;
    background-color:#f4f6f8;
    font-family:Arial, Helvetica, sans-serif;
">

    <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f6f8">
        <tr>
            <td align="center" style="padding:30px 10px;">

                <table width="600" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="max-width:600px;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="
                        background-color:#146adb;
                        padding:20px;
                    ">
                            <h2 style="
                            color:#ffffff;
                            margin:0;
                        ">
                                Book Rental
                            </h2>
                        </td>
                    </tr>

                    <!-- Status -->
                    <tr>
                        <td align="center" style="padding:40px 30px 15px;">

                            <div style="
                            width:70px;
                            height:70px;
                            background-color:#22c55e;
                            border-radius:50%;
                            margin:0 auto 20px;
                            color:#ffffff;
                            font-size:45px;
                            font-weight:bold;
                            line-height:70px;
                            text-align:center;
                        ">
                                ✓
                            </div>

                            <h1 style="
                            color:#222222;
                            font-size:28px;
                            margin:0 0 12px;
                        ">
                                {{statusTitle}}
                            </h1>

                            <p style="
                            color:#555555;
                            font-size:16px;
                            line-height:24px;
                            margin:0;
                        ">
                                {{statusMessage}}
                            </p>

                        </td>
                    </tr>

                    <!-- Order Details -->
                    <tr>
                        <td style="padding:20px 30px 40px;">

                            <table width="100%" cellpadding="20" cellspacing="0" border="0" style="
                                background-color:#f0fdf4;
                                border:1px solid #bbf7d0;
                            ">
                                <tr>
                                    <td align="center">

                                        <p style="
                                        margin:0 0 8px;
                                        color:#666666;
                                        font-size:14px;
                                    ">
                                            Order ID
                                        </p>

                                        <p style="
                                        margin:0 0 15px;
                                        color:#16a34a;
                                        font-size:20px;
                                        font-weight:bold;
                                    ">
                                            {{orderNumber}}
                                        </p>

                                        {{#if bookName}}
                                        <p style="
                                        margin:0;
                                        color:#555555;
                                        font-size:14px;
                                    ">
                                            {{bookName}}
                                        </p>
                                        {{/if}}

                                    </td>
                                </tr>
                            </table>

                            <!-- Track Order Button -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding-top:25px;">
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td align="center" bgcolor="#146adb" style="border-radius:6px;">
                                                    <a href="{{trackingUrl}}" target="_blank" style="
                                                        display:inline-block;
                                                        padding:13px 30px;
                                                        font-size:15px;
                                                        font-weight:bold;
                                                        color:#ffffff;
                                                        text-decoration:none;
                                                        border-radius:6px;
                                                    ">
                                                        Track Your Order
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="
                        padding:20px;
                        border-top:1px solid #eeeeee;
                        background-color:#f8f8f8;
                    ">

                            <p style="
                            color:#555555;
                            font-size:14px;
                            margin:0 0 10px;
                        ">
                                Thank you for choosing Book Rental!
                            </p>

                            <p style="
                            color:#777777;
                            font-size:12px;
                            margin:0 0 6px;
                        ">
                                © {{year}} Book Rental
                            </p>

                            <p style="
                            color:#777777;
                            font-size:12px;
                            margin:0;
                        ">
                                This is an automated email. Please do not reply.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>